{
  "name": "tycl",
  "displayName": "TYCL Language Support",
  "publisher": "pt",
  "description": "Syntax highlighting and some autocompletion for TYCL",
  "version": "1.1.0",
  "icon": "images/logo-low.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:tycl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tycl",
        "aliases": ["TYCL", "tycl"],
        "extensions": [".tycl"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/icon-dark.svg",
          "dark": "./icons/icon-light.svg"
        }
        
      }
    ],
    "grammars": [
      {
        "language": "tycl",
        "scopeName": "source.tycl",
        "path": "./syntaxes/tycl.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  }
}