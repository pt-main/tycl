{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TYCL",
  "scopeName": "source.tycl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#contracts" },
    { "include": "#actions" },
    { "include": "#values" },
    { "include": "#types" },
    { "include": "#keys" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.tycl",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.tycl",
          "match": "//[^\\n]*"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "keyword.control.contract.tycl",
          "match": "\\b(strict|flexible|dynamic)\\b"
        }
      ]
    },
    "actions": {
      "patterns": [
        {
          "name": "support.function.action.tycl",
          "match": "\\b(file|env|join|asString|asObject)\\b(?=\\s*\\()"
        }
      ]
    },
    "keys": {
      "patterns": [
        {
          "name": "entity.name.tag.key.tycl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*(?=\\s*[:=])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.tycl",
          "match": "\\b(int|float|bool|string|object|ints|floats|bools|strings|objects)\\b"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "constant.language.tycl",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "string.quoted.double.tycl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tycl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.tycl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tycl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.numeric.integer.tycl",
          "match": "(?<![\\w.])-?\\d+(?![\\w.])"
        },
        {
          "name": "constant.numeric.float.tycl",
          "match": "(?<![\\w.])-?\\d+\\.\\d+([eE][+-]?\\d+)?(?![\\w.])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.tycl",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.tycl",
          "match": ","
        },
        {
          "name": "punctuation.section.block.begin.tycl",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.tycl",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.tycl",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.tycl",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.tycl",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.tycl",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.colon.tycl",
          "match": ":"
        }
      ]
    }
  }
}